# =============================================================================
# AgentForge AI — environment template (mirrors docs/development/API_CONTRACTS.md §15)
#   cp .env.example .env && make gen-keys      (or simply: make env)
# NEVER commit .env. Values below are SAFE LOCAL-DEV PLACEHOLDERS only.
# =============================================================================

# --- General ------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# --- Data stores (hostnames are docker compose service names) -------------------
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=agentforge
POSTGRES_DB=agentforge
DATABASE_URL=postgresql+asyncpg://agentforge:agentforge@postgres:5432/agentforge
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Execution dispatch -------------------------------------------------------
# inline = run executions inside the API process (core stack, tests, no Kafka)
# kafka  = publish to Kafka for workers (forced by docker-compose.kafka.yml)
EXECUTION_DISPATCH=inline

# --- Auth / crypto (REQUIRED) ------------------------------------------------
# JWT_SECRET: >= 32 random bytes. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#   (or: openssl rand -base64 64 | tr -d '\n')
JWT_SECRET=dev-only-replace-me-with-make-gen-keys
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# CREDENTIAL_ENCRYPTION_KEY: a Fernet key (32 url-safe base64-encoded bytes). Generate with:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   (equivalent to: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode()))
# Rotating it makes previously stored provider credentials unreadable.
CREDENTIAL_ENCRYPTION_KEY=dev-only-replace-me-with-make-gen-keys

# --- HTTP -----------------------------------------------------------------------
# Comma-separated. Add your GitHub Pages origin (https://<owner>.github.io) when
# pointing a Pages-hosted frontend at a real backend.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- LLM ------------------------------------------------------------------------
# true = deterministic mock provider, no external calls (CI/tests/demo)
LLM_MOCK_MODE=false

# --- Sandbox (tool-worker) -------------------------------------------------------
SANDBOX_IMAGE=agentforge-sandbox:1.0.1
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=0.5
SANDBOX_ALLOWED_PACKAGES=requests,httpx,pydantic,python-dateutil
SANDBOX_NETWORK=none
# GID owning /var/run/docker.sock as seen inside containers (Docker Desktop: 0)
DOCKER_SOCKET_GID=0

# --- Observability ----------------------------------------------------------------
# Empty = tracing disabled
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# --- Vector search ----------------------------------------------------------------
EMBEDDING_DIM=768

# --- Frontend (build-time, baked into the bundle — never put secrets here) --------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEMO_MODE=false
VITE_BASE_PATH=/
VITE_ROUTER_MODE=browser

# --- Host ports / image naming (optional overrides) -------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_HOST_PORT=29092
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
REGISTRY=agentforge
IMAGE_TAG=local
