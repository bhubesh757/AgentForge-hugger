# AgentForge AI frontend (build-time; baked into the bundle by Vite)
# Backend API base URL (include /api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1
# true => in-browser mock backend with seeded data (GitHub Pages / no backend)
VITE_DEMO_MODE=false
# Vite base path. "/" locally; "/<repo>/" for GitHub Pages project sites
VITE_BASE_PATH=/
# "browser" (History API) or "hash" (HashRouter; required for GitHub Pages)
VITE_ROUTER_MODE=browser
